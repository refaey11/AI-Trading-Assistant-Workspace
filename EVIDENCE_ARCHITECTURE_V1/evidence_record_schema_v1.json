{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision Brain Evidence Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id","event_time","available_time","source","instrument","feature","value","quality","status"],
  "properties": {
    "evidence_id": {"type":"string","minLength":1},
    "event_time": {"type":"string","format":"date-time"},
    "available_time": {"type":"string","format":"date-time"},
    "source": {"type":"string","minLength":1},
    "instrument": {"type":"string","minLength":1},
    "feature": {"type":"string","minLength":1},
    "value": {},
    "quality": {"type":"string","enum":["AUTHORITATIVE","DERIVED","VALIDATED","STALE","INVALID","MISSING"]},
    "status": {"type":"string","enum":["AVAILABLE","NOT_AVAILABLE","NOT_EVALUABLE","CONFLICT"]},
    "source_event_id": {"type":["string","null"]},
    "latency_seconds": {"type":["number","null"],"minimum":0},
    "lineage": {"type":"array","items":{"type":"string"}},
    "notes": {"type":"string"}
  }
}
